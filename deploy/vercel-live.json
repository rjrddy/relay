{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {"relay": {"root": ".", "runtime": "container", "entrypoint": "Dockerfile.hosted"}},
  "rewrites": [{"source": "/(.*)", "destination": {"service": "relay"}}],
  "daemons": {
    "worker": {"root": ".", "entrypoint": "Dockerfile.hosted", "command": ["/app/relay-hosted", "worker"], "instances": {"iad1": 1}, "resources": {"requests": {"memory": "1Gi"}}}
  }
}
