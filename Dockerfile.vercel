FROM node:22-bookworm-slim AS web
WORKDIR /app/apps/web
COPY apps/web/package*.json ./
RUN npm ci
COPY apps/web/ ./
RUN npm run build
WORKDIR /app
COPY deploy/showcase/ deploy/showcase/
COPY docs/results/chaos-hour.json docs/results/chaos-hour-reconciliation.json docs/results/independent-audit.json docs/results/tests.json docs/results/load-100.json docs/results/load-500.json docs/results/load-1000.json docs/results/hour-export-status.json docs/results/demo.webm docs/results/console-desktop.png docs/results/
RUN node deploy/showcase/build.mjs
FROM golang:1.27.3-bookworm AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
COPY migrations/ migrations/
COPY sdk/go/ sdk/go/
RUN CGO_ENABLED=0 go build -trimpath -o /relay-hosted ./cmd/hosted
FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=builder /relay-hosted /app/relay-hosted
COPY --from=web /app/apps/web/dist /app/web
COPY --from=web /app/deploy/showcase/dist /app/proof
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/app/relay-hosted"]
